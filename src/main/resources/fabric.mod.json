{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "contact": {},
  "license": "${mod_license}",
  "icon": "assets/spatial-gui/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.tastytrash.spatialGUI.client.SpatialGUIClient"
    ],
    "main": [
      "org.tastytrash.spatialGUI.SpatialGUI"
    ],
    "modmenu": [
      "org.tastytrash.spatialGUI.client.SpatialGUIModMenu"
    ]
  },
  "mixins": [
    "spatial-gui.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}",
    "cloth-config": ">=26.0.0"
  }
}
